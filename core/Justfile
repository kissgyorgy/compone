help:
    @just --list

root-dir := canonicalize(source_directory() + "/..")
dist-dir := root-dir + "/core/dist"

[private]
_install-extension version:
    uv pip install --python "{{ root-dir }}/.venvs/py{{ version }}/bin/python" --reinstall --no-deps {{ dist-dir }}/*.whl

[private]
_test-rust version *pytest-params:
    env -u PYTHONPATH "{{ root-dir }}/.venvs/py{{ version }}/bin/pytest" --import-mode=importlib {{ pytest-params }}

[private]
_test-python version *pytest-params:
    PYTHONPATH="{{ root-dir }}/core" "{{ root-dir }}/.venvs/py{{ version }}/bin/pytest" {{ pytest-params }}

[private]
_test-both version: (_install-extension version) (_test-rust version "") (_test-python version "")

[private]
_watchtests recipe *pytest-params:
    watchexec --restart --exts py,rs,toml --stop-timeout 0 -- 'just {{ recipe }} 3.14 {{ pytest-params }}'

[private]
_publish token url:
    #!/usr/bin/env bash
    set -euo pipefail
    export UV_PUBLISH_TOKEN=$(op read op://Secrets/{{ token }}/credential)
    if [[ -n "{{ url }}" ]]; then
        export UV_PUBLISH_URL="{{ url }}"
    fi
    ls -la {{ dist-dir }}
    uv publish {{ dist-dir }}/*

# Run linters and other checks
check:
    prek run --all-files --hook-stage manual

build-package:
    #!/usr/bin/env bash
    uv build --clear --wheel --config-setting=--build-option=--py-limited-api=cp310 --out-dir {{ dist-dir }}
    bash scripts/verify-wheel-contents.sh {{ dist-dir }}/*.whl

# Build and install the Rust extension for one Python version
build-extension version="3.14": build-package (_install-extension version)

# Run tests against the released Rust package (the default)
test version="3.14" *pytest-params="": (build-extension version) (_test-rust version pytest-params)

# Run tests against an already-installed Rust package without rebuilding
test-installed version="3.14" *pytest-params="": (_test-rust version pytest-params)

# Run tests against the retained Python implementation
test-python version="3.14" *pytest-params="": (_test-python version pytest-params)

# Run both implementations with all supported Python versions
test-all: build-package (_test-both "3.10") (_test-both "3.11") (_test-both "3.12") (_test-both "3.13") (_test-both "3.14")

# Run tests continuously against the default Rust package
watchtests *pytest-params="": (_watchtests "test" pytest-params)

# Run tests continuously against the retained Python implementation
watchtests-python *pytest-params="": (_watchtests "test-python" pytest-params)

testpypi-release: build-package (_publish "test-pypi-token" "https://test.pypi.org/legacy/")

release: check test-all (_publish "pypi-token" "")
